# LLM Configuration
LLM_PROVIDER=ollama  # Options: ollama, lm_studio, openrouter
OLLAMA_BASE_URL=http://localhost:11434
LM_STUDIO_BASE_URL=http://localhost:1234
OPENROUTER_API_KEY=your_api_key_here

# Model Configuration
MODEL_NAME=qwen2.5:latest
EMBEDDING_MODEL=nomic-embed-text

# Storage Configuration (All data stored locally in data/ folder)
GRAPH_STORAGE_PATH=./data/graph
PROCESSED_DATA_PATH=./data/processed
MAX_CONTEXT_LENGTH=8192
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Data Ingestion
COURSE_WEBSITE_URL=https://pantelis.github.io/aiml-common/
DATA_DIR=./data/raw
